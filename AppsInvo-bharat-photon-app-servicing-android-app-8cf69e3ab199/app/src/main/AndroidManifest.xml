<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".base.MyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/service_app_icon"
        android:label="@string/app_name"
        android:roundIcon="@drawable/service_app_icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.BharatPhotonServiceApp"
        tools:targetApi="31"
        >
        <activity
            android:name=".ui.activities.product_subscription.SubscriptionCustomerRemarkActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activities.product_subscription.SubscriptionSetupActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activities.product_subscription.SubscriptionDetailsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activities.product_complaint.ComplaintCustomerRemarkActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activities.CustomerOTPActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activities.product_complaint.SINUpdateActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activities.product_installation.CustomerRemarksActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activities.product_installation.SINSetUpActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activities.SupportActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activities.ReviewAndRatingActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activities.TermsAndConditionsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activities.PrivacyPolicyActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activities.AboutUsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activities.product_complaint.ComplaintDetailsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activities.product_installation.ProductDetailsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activities.HomeActivity"
            android:theme="@style/Theme.BharatPhotonServiceApp"
            android:exported="false" />
        <activity
            android:name=".ui.activities.OTPActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activities.SetPasswordActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activities.ForgotPasswordActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activities.LoginActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activities.SplashScreenActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="app.bharatphoton.service.fileProvider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/provider_path" />
        </provider>

        <service
            android:name=".utils.MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>
</manifest>