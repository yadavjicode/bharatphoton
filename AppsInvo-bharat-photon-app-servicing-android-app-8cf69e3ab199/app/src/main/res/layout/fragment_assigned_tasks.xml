<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/photon_dull_white"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.fragments.AssignedTasksFragment">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayoutAssignedTask"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        >
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabsAssignedTask"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="@dimen/_2sdp"
            app:tabGravity="fill"
            app:tabMode="scrollable"
            android:textAlignment="center"
            android:background="@color/photon_dull_white"
            app:tabIndicatorFullWidth="true"
            app:tabIndicatorColor="@color/photon_orange"
            app:tabRippleColor="@color/photon_gray"
            app:tabTextAppearance="@style/MyTabLayoutTextAppearanceWithSecondFont"
            app:tabSelectedTextColor="@color/photon_orange"
            app:tabTextColor="@android:color/black"
            />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.viewpager.widget.ViewPager
        android:id="@+id/viewPagerAssignedTask"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/appBarLayoutAssignedTask"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />

</androidx.constraintlayout.widget.ConstraintLayout>