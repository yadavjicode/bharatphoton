<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/clComplaintRemark"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.activities.product_complaint.ComplaintCustomerRemarkActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clLoader"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="@dimen/_10sdp"
        android:background="@android:drawable/screen_background_light_transparent"
        android:focusable="false">
        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="visible"
            android:elevation="@dimen/_10sdp"
            android:indeterminateDrawable="@drawable/custom_circular_progress_bar"
            android:indeterminate="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/_10sdp"
        android:background="@drawable/white_orange_gradient_bg"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        >
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:shapeAppearance="@style/RoundedSquare10"
            android:src="@drawable/back_arrow"
            android:layout_gravity="center_vertical"
            android:gravity="center_vertical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Customer Remark"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:gravity="center"
            android:textSize="@dimen/_15sdp"
            android:textColor="@color/black"
            style="@style/SecondFontFamily"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@+id/clTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            >
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="@dimen/_10sdp"
                android:background="@drawable/white_orange_gradient_bg"
                >
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/llUploadImg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/orange_dotted_10stroked_bg"
                    android:layout_marginHorizontal="@dimen/_20sdp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    >
                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivUploadImg"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_150sdp"
                        android:scaleType="centerCrop"
                        android:padding="@dimen/_5sdp"
                        app:shapeAppearance="@style/RoundedSquare10"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        />
                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivPlay"
                        android:layout_width="@dimen/_20sdp"
                        android:layout_height="@dimen/_20sdp"
                        android:visibility="gone"
                        android:scaleType="centerCrop"
                        android:src="@drawable/play_button"
                        android:background="@drawable/white_10cornered_bg"
                        app:layout_constraintTop_toTopOf="@+id/ivUploadImg"
                        app:layout_constraintBottom_toBottomOf="@+id/ivUploadImg"
                        app:layout_constraintEnd_toEndOf="@+id/ivUploadImg"
                        app:layout_constraintStart_toStartOf="@+id/ivUploadImg"
                        />
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="@dimen/_10sdp"
                        app:layout_constraintBottom_toBottomOf="@+id/ivUploadImg"
                        app:layout_constraintStart_toStartOf="@+id/ivUploadImg"
                        app:layout_constraintEnd_toEndOf="@+id/ivUploadImg"
                        >
                        <LinearLayout
                            android:id="@+id/llUploadPhotoVideo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            >
                            <com.google.android.material.imageview.ShapeableImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:src="@drawable/upload_img"
                                />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Upload Photo &amp; Video"
                                android:textSize="@dimen/_10sdp"
                                android:textColor="@color/photon_gray"
                                android:layout_gravity="center_horizontal"
                                style="@style/FontFamilyHelvetica"
                                />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvBtnChoose"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/ripple_orange_5cornered_bg"
                            android:paddingVertical="@dimen/_5sdp"
                            android:paddingHorizontal="@dimen/_7sdp"
                            android:layout_marginTop="@dimen/_7sdp"
                            android:text="Choose File"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_10sdp"
                            style="@style/SecondFontFamily"
                            android:layout_gravity="center_horizontal"
                            />
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_20sdp"
                    android:text="Customer Remark"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_12sdp"
                    style="@style/SecondFontFamily"
                    android:layout_gravity="start"
                    android:layout_marginHorizontal="@dimen/_20sdp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/llUploadImg"
                    />
            </androidx.constraintlayout.widget.ConstraintLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="5"
                android:orientation="horizontal"
                android:background="@drawable/black_10stroked_bg"
                android:layout_marginHorizontal="@dimen/_20sdp"
                android:layout_marginBottom="@dimen/_10sdp"
                android:paddingVertical="@dimen/_10sdp"
                >
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/edit_icon_orange"
                    android:layout_weight=".1"
                    android:paddingVertical="@dimen/_5sdp"
                    android:paddingHorizontal="@dimen/_10sdp"
                    android:layout_gravity="start"
                    />
                <EditText
                    android:id="@+id/etCustomerRemark"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_100sdp"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLines="15"
                    android:autofillHints="false"
                    android:layout_weight="5"
                    android:imeOptions="actionNext"
                    android:hint="Enter Remark"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:textColorHint="@color/photon_light_gray"
                    android:textSize="@dimen/_10sdp"
                    android:layout_gravity="start"
                    android:gravity="start"
                    android:backgroundTint="@android:color/transparent"
                    android:layout_marginEnd="@dimen/_5sdp"
                    />
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_20sdp"
                android:text="Customer Representative Name"
                android:textColor="@color/black"
                android:textSize="@dimen/_12sdp"
                style="@style/SecondFontFamily"
                android:layout_gravity="start"
                android:layout_marginHorizontal="@dimen/_20sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ivUploadImg"
                />
            <EditText
                android:id="@+id/etCustomerName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                android:hint="Enter Name"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:autofillHints="false"
                android:textColorHint="@color/photon_light_gray"
                android:textSize="@dimen/_10sdp"
                android:lines="1"
                android:layout_gravity="center_vertical"
                android:gravity="start|center_vertical"
                android:inputType="textCapWords"
                android:maxLength="30"
                android:background="@drawable/black_10stroked_bg"
                android:paddingHorizontal="@dimen/_10sdp"
                android:paddingVertical="@dimen/_20sdp"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_marginHorizontal="@dimen/_20sdp"
                />
            <TextView
                android:id="@+id/tvBtnResolveComplaint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_40sdp"
                android:background="@drawable/ripple_orange_50cornered_bg"
                android:paddingVertical="@dimen/_10sdp"
                style="@style/FontFamilyHelvetica"
                android:text="Resolve Complaint"
                android:elevation="@dimen/_5sdp"
                android:textColor="@color/white"
                android:textSize="@dimen/_12sdp"
                android:textStyle="bold"
                android:layout_marginHorizontal="@dimen/_20sdp"
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal"
                />
            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="match_parent"
                android:layout_height="@dimen/_30sdp"
                app:shapeAppearance="@style/RoundedSquare10"
                android:src="@drawable/logo_icon_small"
                android:layout_marginTop="@dimen/_30sdp"
                android:layout_marginBottom="@dimen/_10sdp"
                />
            <View
                android:id="@+id/view"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginBottom="@dimen/_50sdp"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>