<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/clComplaintDetails"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/photon_dull_white"
    tools:context=".ui.activities.product_complaint.ComplaintDetailsActivity">

    <androidx.cardview.widget.CardView
        android:id="@+id/cvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="@dimen/_10sdp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        >
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/_10sdp"
            >
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:shapeAppearance="@style/RoundedSquare10"
                android:src="@drawable/back_arrow"
                android:layout_gravity="center_vertical"
                android:gravity="center_vertical"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Complaint Detail"
                android:textStyle="bold"
                android:layout_gravity="center_vertical"
                android:gravity="center_vertical"
                android:textSize="@dimen/_15sdp"
                android:textColor="@color/black"
                android:layout_marginStart="@dimen/_5sdp"
                style="@style/SecondFontFamily"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:shimmer_auto_start="true"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/cvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <include layout="@layout/item_shimmer_layout_for_details" />
        </LinearLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsvDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@+id/cvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            >
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Product Details"
                android:textStyle="bold"
                android:layout_gravity="center_vertical"
                android:gravity="start"
                android:textSize="@dimen/_12sdp"
                android:textColor="@color/black"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_10sdp"
                />
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/_10sdp"
                app:cardUseCompatPadding="true"
                android:elevation="@dimen/_5sdp"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_marginHorizontal="@dimen/_5sdp"
                >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    >
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingTop="@dimen/_10sdp"
                        android:layout_marginHorizontal="@dimen/_10sdp"
                        >
                        <TextView
                            android:id="@+id/tvStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="In Progress"
                            android:layout_gravity="start"
                            android:gravity="start"
                            android:textSize="@dimen/_10sdp"
                            android:textColor="@color/photon_dark_blue"
                            android:textStyle="bold"
                            app:drawableStartCompat="@drawable/in_progress_highlight"
                            android:drawablePadding="@dimen/_3sdp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Complaint No. "
                            android:textSize="@dimen/_10sdp"
                            android:textColor="@color/black"
                            app:drawableStartCompat="@drawable/ticket_icon"
                            android:drawablePadding="@dimen/_1sdp"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintRight_toLeftOf="@+id/tvTicketNumber"
                            />
                        <TextView
                            android:id="@+id/tvTicketNumber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="#1234"
                            style="@style/FontFamilyHelvetica"
                            android:textSize="@dimen/_10sdp"
                            android:textColor="@color/black"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:layout_marginHorizontal="@dimen/_10sdp"
                        >
                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/productImg"
                            android:layout_width="@dimen/_50sdp"
                            android:layout_height="@dimen/_50sdp"
                            app:shapeAppearance="@style/RoundedSquare10"
                            android:scaleType="centerCrop"
                            tools:src="@drawable/product_details_product_img"
                            />
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:layout_marginStart="@dimen/_5sdp"
                            >
                            <TextView
                                android:id="@+id/tvProductName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="Sensor Tap"
                                android:textStyle="bold"
                                android:layout_gravity="center_vertical"
                                android:gravity="start"
                                android:textSize="@dimen/_10sdp"
                                android:textColor="@color/photon_orange"
                                android:layout_marginStart="@dimen/_5sdp"
                                />
                            <TextView
                                android:id="@+id/tvProductDescription"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="Automatic Sensor Tap DC"
                                android:textStyle="bold"
                                android:lines="1"
                                android:ellipsize="end"
                                style="@style/FontFamilyHelvetica"
                                android:layout_gravity="center_vertical"
                                android:gravity="start"
                                android:textSize="@dimen/_12sdp"
                                android:textColor="@color/black"
                                android:layout_marginStart="@dimen/_5sdp"
                                />
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginStart="@dimen/_5sdp"
                                >
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Model Name :  "
                                    android:layout_gravity="center_vertical"
                                    android:gravity="start"
                                    android:textSize="@dimen/_10sdp"
                                    android:textColor="@color/black"
                                    />
                                <TextView
                                    android:id="@+id/tvModelName"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    tools:text="BP-F102"
                                    style="@style/FontFamilyHelvetica"
                                    android:textStyle="bold"
                                    android:layout_gravity="center_vertical"
                                    android:gravity="start"
                                    android:textSize="@dimen/_10sdp"
                                    android:textColor="@color/black"
                                    />
                            </LinearLayout>

                        </LinearLayout>
                    </LinearLayout>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/photon_light_gray"
                        android:layout_marginTop="@dimen/_10sdp"
                        />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SIN No :"
                        style="@style/FontFamilyHelvetica"
                        android:textStyle="bold"
                        android:layout_gravity="center_vertical"
                        android:gravity="start"
                        android:textSize="@dimen/_10sdp"
                        android:textColor="@color/black"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:layout_marginHorizontal="@dimen/_10sdp"
                        />
                    <!--<TextView
                        android:id="@+id/tvSin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="1234-1234-1234"
                        android:textStyle="bold"
                        android:background="@drawable/ripple_black_5cornered_bg"
                        android:paddingHorizontal="@dimen/_10sdp"
                        android:paddingVertical="@dimen/_5sdp"
                        android:layout_gravity="center_vertical"
                        android:gravity="start"
                        android:textSize="@dimen/_10sdp"
                        android:textColor="@color/black"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:layout_marginHorizontal="@dimen/_10sdp"
                        android:layout_marginBottom="@dimen/_10sdp"
                        />-->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvSin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:layout_marginHorizontal="@dimen/_5sdp"
                        android:layout_marginBottom="@dimen/_5sdp"
                        />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Customer Details"
                android:textStyle="bold"
                android:layout_gravity="center_vertical"
                android:gravity="start"
                android:textSize="@dimen/_12sdp"
                android:textColor="@color/black"
                android:layout_marginTop="@dimen/_10sdp"
                android:layout_marginHorizontal="@dimen/_10sdp"
                />
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/_10sdp"
                app:cardUseCompatPadding="true"
                android:elevation="@dimen/_5sdp"
                android:orientation="vertical"
                android:layout_marginHorizontal="@dimen/_5sdp"
                >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/_10sdp"
                    >
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="5"
                        >
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_weight="5"
                            >
                            <TextView
                                android:id="@+id/tvUserName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="Adam GaretteAdam GaretteAdam GaretteAdam GaretteAdam Garette"
                                style="@style/FontFamilyHelvetica"
                                android:textStyle="bold"
                                android:layout_gravity="center_vertical"
                                android:gravity="start"
                                android:textSize="@dimen/_10sdp"
                                android:textColor="@color/black"
                                android:layout_marginTop="@dimen/_5sdp"
                                />
                            <TextView
                                android:id="@+id/tvUserPhone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="+91 8559273459"
                                android:layout_gravity="start"
                                android:gravity="start"
                                android:textSize="@dimen/_10sdp"
                                android:textColor="@color/black"
                                app:drawableStartCompat="@drawable/phone_icon"
                                android:drawablePadding="@dimen/_5sdp"
                                android:layout_marginTop="@dimen/_2sdp"
                                />
                            <TextView
                                android:id="@+id/tvUserEmail"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="adam.garette@gmail.com"
                                android:layout_gravity="start"
                                android:gravity="start"
                                android:textSize="@dimen/_10sdp"
                                android:textColor="@color/black"
                                app:drawableStartCompat="@drawable/email_icon"
                                android:drawablePadding="@dimen/_5sdp"
                                android:layout_marginTop="@dimen/_2sdp"
                                />
                        </LinearLayout>
                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/ivUserImg"
                            android:layout_width="@dimen/_50sdp"
                            android:layout_height="@dimen/_50sdp"
                            app:shapeAppearance="@style/Circular"
                            android:scaleType="centerCrop"
                            android:src="@drawable/default_gray_person_image"
                            android:layout_gravity="center_vertical"
                            />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="@dimen/_10sdp"
                        >
                        <com.google.android.material.imageview.ShapeableImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:shapeAppearance="@style/Circular"
                            android:src="@drawable/home_icon"
                            />
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="@dimen/_10sdp"
                            >
                            <TextView
                                android:id="@+id/tvAddress"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="84 Murphy Street"
                                style="@style/FontFamilyHelvetica"
                                android:layout_gravity="center_vertical"
                                android:gravity="start"
                                android:textSize="@dimen/_12sdp"
                                android:textColor="@color/black"
                                />
                            <TextView
                                android:id="@+id/tvCity"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="Orchid Valley, Western"
                                android:layout_gravity="start"
                                android:gravity="start"
                                android:textSize="@dimen/_10sdp"
                                android:textColor="@color/black"
                                />
                            <TextView
                                android:id="@+id/tvState"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="Australia(WA)"
                                android:layout_gravity="start"
                                android:gravity="start"
                                android:textSize="@dimen/_10sdp"
                                android:textColor="@color/black"
                                />
                            <TextView
                                android:id="@+id/tvPincode"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="123456"
                                android:layout_gravity="start"
                                android:gravity="start"
                                android:textSize="@dimen/_10sdp"
                                android:textColor="@color/black"
                                />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/_10sdp"
                app:cardUseCompatPadding="true"
                android:elevation="@dimen/_5sdp"
                android:orientation="vertical"
                android:layout_marginHorizontal="@dimen/_5sdp"
                >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/_10sdp"
                    >
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Complaint Issues"
                        android:layout_gravity="center_vertical"
                        android:gravity="start"
                        android:textSize="@dimen/_10sdp"
                        android:textColor="@color/black"
                        android:textStyle="bold"
                        style="@style/FontFamilyHelvetica"
                        />
                    <TextView
                        android:id="@+id/tvComplaintReason"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="No water coming from taps.."
                        android:layout_gravity="start"
                        android:gravity="start"
                        android:textSize="@dimen/_10sdp"
                        android:textColor="@color/black"
                        />
                    <TextView
                        android:id="@+id/tvComplaintDescription"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="No water coming from taps.."
                        android:layout_gravity="start"
                        android:gravity="start"
                        android:textSize="@dimen/_10sdp"
                        android:textColor="@color/black"
                        />
                    <TextView
                        android:id="@+id/tvResolveDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Tue,27 Aug 2024"
                        android:layout_gravity="end"
                        android:gravity="end"
                        android:textSize="@dimen/_10sdp"
                        android:textColor="@color/black"
                        android:drawablePadding="@dimen/_5sdp"
                        app:drawableStartCompat="@drawable/calendar_icon" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Complaint Media"
                android:textStyle="bold"
                android:layout_gravity="center_vertical"
                android:gravity="start"
                android:textSize="@dimen/_12sdp"
                android:textColor="@color/black"
                android:layout_marginTop="@dimen/_10sdp"
                android:layout_marginStart="@dimen/_10sdp"
                />
            <TextView
                android:id="@+id/tvNoPhoto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:text="Media Not Available"
                android:textStyle="bold"
                android:layout_gravity="center"
                android:gravity="start"
                android:textSize="@dimen/_10sdp"
                android:textColor="@color/photon_gray"
                android:layout_marginTop="@dimen/_10sdp"
                android:layout_marginHorizontal="@dimen/_10sdp"
                />
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvComplaintMedia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_marginHorizontal="@dimen/_5sdp"
                />
            <LinearLayout
                android:id="@+id/llCompletedData"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                >
                <TextView
                    android:id="@+id/tvRemarkDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Remarks"
                    android:textStyle="bold"
                    android:layout_gravity="center_vertical"
                    android:gravity="start"
                    android:textSize="@dimen/_12sdp"
                    android:textColor="@color/black"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:layout_marginStart="@dimen/_10sdp"
                    />
                <androidx.cardview.widget.CardView
                    android:id="@+id/cvRemarkDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="@dimen/_10sdp"
                    app:cardUseCompatPadding="true"
                    android:elevation="@dimen/_5sdp"
                    android:orientation="vertical"
                    android:layout_marginHorizontal="@dimen/_5sdp"
                    android:layout_gravity="center_horizontal"
                    android:gravity="center_horizontal"
                    >
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/_10sdp"
                        android:layout_gravity="center_horizontal"
                        android:gravity="center_horizontal"
                        >
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_gravity="center_horizontal"
                            android:gravity="center_horizontal"
                            >
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Representative Name : "
                                android:layout_gravity="end"
                                android:gravity="end"
                                android:textSize="@dimen/_10sdp"
                                android:textColor="@color/black"
                                />
                            <TextView
                                android:id="@+id/tvRepresentativeName"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                tools:text="Adam GaretteAdam GaretteAdam GaretteAdam "
                                android:textStyle="bold"
                                android:layout_gravity="start"
                                android:gravity="start"
                                android:textSize="@dimen/_10sdp"
                                android:textColor="@color/black"
                                />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="@dimen/_2sdp"
                            android:layout_gravity="center_horizontal"
                            android:gravity="center_horizontal"
                            >
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Remarks : "
                                android:layout_gravity="end"
                                android:gravity="end"
                                android:textSize="@dimen/_10sdp"
                                android:textColor="@color/black"
                                />
                            <TextView
                                android:id="@+id/tvRemark"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                tools:text="Good remarksGood remarksGood remarksGood remarksGood remarks"
                                android:textStyle="bold"
                                android:layout_gravity="start"
                                android:gravity="start"
                                android:textSize="@dimen/_10sdp"
                                android:textColor="@color/black"
                                />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Remarks Media"
                    android:textStyle="bold"
                    android:layout_gravity="center_vertical"
                    android:gravity="start"
                    android:textSize="@dimen/_12sdp"
                    android:textColor="@color/black"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:layout_marginStart="@dimen/_10sdp"
                    />
                <TextView
                    android:id="@+id/tvNoRemarksPhoto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:text="Media Not Available"
                    android:textStyle="bold"
                    android:layout_gravity="center"
                    android:gravity="start"
                    android:textSize="@dimen/_10sdp"
                    android:textColor="@color/photon_gray"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:layout_marginHorizontal="@dimen/_10sdp"
                    />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvRemarksMedia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:layout_marginHorizontal="@dimen/_5sdp"
                    />
            </LinearLayout>
            <View
                android:id="@+id/view"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginBottom="@dimen/_100sdp"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_30sdp"
        android:paddingVertical="@dimen/_10sdp"
        android:background="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        >
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivLogoImage"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_30sdp"
            android:src="@drawable/logo_icon_small"
            />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>