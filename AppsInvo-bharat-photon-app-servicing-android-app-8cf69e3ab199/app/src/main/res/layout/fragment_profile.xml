<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/clProfile"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_gradient"
    tools:context=".ui.fragments.ProfileFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        >
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            >
            <LinearLayout
                android:id="@+id/llProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="@dimen/_10sdp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                >
                <androidx.cardview.widget.CardView
                    android:id="@+id/cvProfile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="@dimen/_10sdp"
                    app:cardUseCompatPadding="true"
                    android:elevation="@dimen/_5sdp"
                    android:layout_marginHorizontal="@dimen/_8sdp"
                    >
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="@dimen/_15sdp"
                        android:layout_gravity="center"
                        android:gravity="center"
                        >
                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/ivProfile"
                            android:layout_width="@dimen/_40sdp"
                            android:layout_height="@dimen/_40sdp"
                            app:shapeAppearance="@style/Circular"
                            android:scaleType="centerCrop"
                            android:elevation="@dimen/_1sdp"
                            android:layout_gravity="center_vertical"
                            android:src="@drawable/top_user_profile"
                            />
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="@dimen/_20sdp"
                            android:layout_gravity="center_vertical"
                            >
                            <TextView
                                android:id="@+id/tvName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="Denial"
                                android:layout_gravity="start"
                                android:gravity="start"
                                android:textSize="@dimen/_10sdp"
                                style="@style/FontFamilyHelvetica"
                                android:textColor="@color/black"
                                />
                            <TextView
                                android:id="@+id/tvPhone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="+91 8559273459"
                                android:textStyle="bold"
                                android:layout_gravity="start"
                                android:gravity="start"
                                android:textSize="@dimen/_10sdp"
                                android:textColor="@color/black"
                                android:drawablePadding="@dimen/_5sdp"
                                app:drawableStartCompat="@drawable/phone_icon"
                                android:layout_marginTop="@dimen/_3sdp"
                                />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <TextView
                    android:id="@+id/tvOtherLinks"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Other Links"
                    style="@style/SecondFontFamily"
                    android:textStyle="bold"
                    android:layout_gravity="start"
                    android:gravity="start"
                    android:textSize="@dimen/_12sdp"
                    android:textColor="@color/black"
                    android:layout_marginStart="@dimen/_12sdp"
                    android:layout_marginTop="@dimen/_20sdp"
                    />
            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:id="@+id/cvOtherLinks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/_10sdp"
                app:cardUseCompatPadding="true"
                android:elevation="@dimen/_5sdp"
                android:orientation="vertical"
                android:layout_marginHorizontal="@dimen/_8sdp"
                app:layout_constraintTop_toBottomOf="@+id/llProfile"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    >
                    <LinearLayout
                        android:id="@+id/llAboutUs"
                        android:weightSum="5"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="@dimen/_10sdp"
                        android:background="?selectableItemBackground"
                        >
                        <ImageView
                            android:layout_weight="2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:src="@drawable/about_us"/>
                        <TextView
                            android:layout_weight=".9"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:text="About Us"
                            android:textSize="@dimen/_10sdp"
                            android:textColor="@color/black"
                            style="@style/FontFamilyHelvetica"
                            />
                        <ImageView
                            android:layout_weight="2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:src="@drawable/arrow_forward_gray"
                            android:layout_gravity="center_vertical"
                            />
                    </LinearLayout>
<!--
                    <LinearLayout
                        android:id="@+id/llReviewRatings"
                        android:weightSum="5"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="@dimen/_10sdp"
                        android:background="?selectableItemBackground"
                        android:gravity="center_vertical"
                        >
                        <ImageView
                            android:layout_weight="2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:src="@drawable/review_rating"/>
                        <TextView
                            android:layout_weight=".9"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:layout_gravity="center_vertical"
                            android:text="Review &amp; Ratings"
                            android:textSize="@dimen/_10sdp"
                            android:textColor="@color/black"
                            style="@style/FontFamilyHelvetica"
                            />
                        <ImageView
                            android:layout_weight="2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:src="@drawable/arrow_forward_gray"
                            android:layout_gravity="center_vertical"
                            />
                    </LinearLayout>
-->
                    <LinearLayout
                        android:id="@+id/llTermsConditions"
                        android:weightSum="5"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="@dimen/_10sdp"
                        android:background="?selectableItemBackground"
                        >
                        <ImageView
                            android:layout_weight="2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:src="@drawable/terms_conditions"/>
                        <TextView
                            android:layout_weight=".9"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:text="Terms and Conditions"
                            android:textSize="@dimen/_10sdp"
                            android:textColor="@color/black"
                            style="@style/FontFamilyHelvetica"
                            />
                        <ImageView
                            android:layout_weight="2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:src="@drawable/arrow_forward_gray"
                            android:layout_gravity="center_vertical"
                            />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/llPrivacyPolicy"
                        android:weightSum="5"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="@dimen/_10sdp"
                        android:background="?selectableItemBackground"
                        >
                        <ImageView
                            android:layout_weight="2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:src="@drawable/privacy_policy"/>
                        <TextView
                            android:layout_weight=".9"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:text="Privacy Policy"
                            android:textSize="@dimen/_10sdp"
                            android:textColor="@color/black"
                            style="@style/FontFamilyHelvetica"
                            />
                        <ImageView
                            android:layout_weight="2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:src="@drawable/arrow_forward_gray"
                            android:layout_gravity="center_vertical"
                            />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/llHelpSupport"
                        android:weightSum="5"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="@dimen/_10sdp"
                        android:background="?selectableItemBackground"
                        >
                        <ImageView
                            android:layout_weight="2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:src="@drawable/help_support"/>
                        <TextView
                            android:layout_weight=".9"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:text="Help &amp; Support"
                            android:textSize="@dimen/_10sdp"
                            android:textColor="@color/black"
                            style="@style/FontFamilyHelvetica"
                            />
                        <ImageView
                            android:layout_weight="2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:src="@drawable/arrow_forward_gray"
                            android:layout_gravity="center_vertical"
                            />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <TextView
                android:id="@+id/tvBtnLogout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_20sdp"
                android:background="@drawable/ripple_orange_50cornered_bg"
                android:paddingVertical="@dimen/_8sdp"
                android:paddingHorizontal="@dimen/_20sdp"
                android:text="Logout"
                android:textColor="@color/white"
                android:textSize="@dimen/_12sdp"
                android:textStyle="bold"
                style="@style/FontFamilyHelvetica"
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal"
                android:drawablePadding="@dimen/_5sdp"
                app:drawableStartCompat="@drawable/logout"
                app:layout_constraintTop_toBottomOf="@+id/cvOtherLinks"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>