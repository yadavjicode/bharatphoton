<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginHorizontal="@dimen/_5sdp"
    android:background="@color/photon_dull_white">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_2sdp"
        app:cardCornerRadius="@dimen/_10sdp"
        app:cardUseCompatPadding="true"
        android:elevation="@dimen/_10sdp"
        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            >
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="@dimen/_10sdp"
                android:layout_marginHorizontal="@dimen/_10sdp"
                >
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Resolved"
                    style="@style/FontFamilyHelvetica"
                    android:layout_gravity="start"
                    android:gravity="start"
                    android:textSize="@dimen/_10sdp"
                    android:textColor="@color/photon_dark_green"
                    android:textStyle="bold"
                    app:drawableStartCompat="@drawable/resolved_highlight"
                    android:drawablePadding="@dimen/_3sdp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Complaint No. "
                    android:textSize="@dimen/_10sdp"
                    android:textColor="@color/black"
                    app:drawableStartCompat="@drawable/ticket_icon"
                    android:drawablePadding="@dimen/_1sdp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintRight_toLeftOf="@+id/tvTicketNumber"
                    />
                <TextView
                    android:id="@+id/tvTicketNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="#1234"
                    style="@style/FontFamilyHelvetica"
                    android:textSize="@dimen/_10sdp"
                    android:textColor="@color/black"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_marginHorizontal="@dimen/_10sdp"
                >
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivProfile"
                    android:layout_width="@dimen/_40sdp"
                    android:layout_height="@dimen/_40sdp"
                    app:shapeAppearance="@style/Circular"
                    android:scaleType="centerCrop"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/top_user_profile"
                    />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:layout_gravity="start"
                    >
                    <TextView
                        android:id="@+id/tvName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Denial"
                        android:textStyle="bold"
                        android:layout_gravity="start"
                        style="@style/FontFamilyHelvetica"
                        android:gravity="start"
                        android:textSize="@dimen/_10sdp"
                        android:textColor="@color/black"
                        android:layout_marginStart="@dimen/_5sdp"
                        />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_gravity="start"
                        android:gravity="start"
                        android:layout_marginStart="@dimen/_5sdp"
                        android:layout_marginEnd="@dimen/_10sdp"
                        >
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Resolve Date :"
                            android:textStyle="bold"
                            android:gravity="center_vertical"
                            android:layout_gravity="center_vertical"
                            android:textSize="@dimen/_10sdp"
                            android:textColor="@color/black"
                            />
                        <TextView
                            android:id="@+id/tvResolveDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Aug 20, 2024"
                            android:gravity="center_vertical"
                            android:layout_gravity="center_vertical"
                            android:textSize="@dimen/_10sdp"
                            android:background="@drawable/black_5stroked_bg"
                            android:textColor="@color/black"
                            android:layout_marginStart="@dimen/_5sdp"
                            android:paddingVertical="@dimen/_2sdp"
                            android:paddingHorizontal="@dimen/_10sdp"
                            app:drawableStartCompat="@drawable/calendar_icon"
                            android:drawablePadding="@dimen/_5sdp"
                            />
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/photon_light_gray"
                android:layout_marginTop="@dimen/_5sdp"
                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Complaint Issues"
                android:layout_gravity="start"
                android:gravity="start"
                style="@style/FontFamilyHelvetica"
                android:textSize="@dimen/_12sdp"
                android:textColor="@color/black"
                android:layout_marginHorizontal="@dimen/_20sdp"
                />
            <TextView
                android:id="@+id/tvComplaintIssue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No water coming from taps.."
                android:layout_gravity="start"
                android:gravity="start"
                android:textSize="@dimen/_12sdp"
                android:textColor="@color/black"
                android:layout_marginHorizontal="@dimen/_20sdp"
                />
            <TextView
                android:id="@+id/tvComplaintDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No water coming from taps.."
                android:layout_gravity="start"
                android:gravity="start"
                android:textSize="@dimen/_12sdp"
                android:textColor="@color/black"
                android:layout_marginStart="@dimen/_20sdp"
                />
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/photon_light_gray"
                android:layout_marginTop="@dimen/_5sdp"
                />
            <TextView
                android:id="@+id/tvBtnView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:background="@drawable/ripple_orange_50cornered_bg"
                android:paddingVertical="@dimen/_4sdp"
                android:paddingHorizontal="@dimen/_40sdp"
                android:layout_marginBottom="@dimen/_10sdp"
                android:layout_marginEnd="@dimen/_10sdp"
                android:text="View"
                android:textColor="@color/white"
                android:textSize="@dimen/_12sdp"
                style="@style/FontFamilyHelvetica"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_gravity="end"
                app:layout_constraintTop_toBottomOf="@+id/llConfirmPassword"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>