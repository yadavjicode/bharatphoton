<rotate xmlns:android="http://schemas.android.com/apk/res/android"
    android:fromDegrees="0"
    android:toDegrees="360"
    android:pivotX="50%"
    android:pivotY="50%">
    <shape android:shape="ring" android:thicknessRatio="8"
        android:useLevel="false">
        <size android:width="@dimen/_40sdp" android:height="@dimen/_40sdp" />
        <gradient
            android:type="sweep"
            android:useLevel="false"
            android:startColor="@color/photon_orange"
            android:endColor="@color/photon_light_orange" />
    </shape>
</rotate>
