<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Circular">
        <item name="cornerSize">50%</item>
    </style>

    <style name="RoundedSquare10">
        <item name="cornerSize">10%</item>
    </style>

    <style name="RoundedSquare20">
        <item name="cornerSize">20%</item>
    </style>

    <style name="RoundedSquare30">
        <item name="cornerSize">30%</item>
    </style>

    <style name="RoundedSquare40">
        <item name="cornerSize">40%</item>
    </style>

    <style name="RoundedSquare50">
        <item name="cornerSize">50%</item>
    </style>

    <style name="MyTabLayoutTextAppearance" parent="TextAppearance.AppCompat.Widget.ActionBar.Title.Inverse">
        <item name="android:textSize">@dimen/_12sdp</item>
        <item name="android:fontFamily">@font/helvetica</item>
        <item name="android:textStyle">bold</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="MyTabLayoutTextAppearanceWithSecondFont" parent="TextAppearance.AppCompat.Widget.ActionBar.Title.Inverse">
        <item name="android:textSize">@dimen/_12sdp</item>
        <item name="android:fontFamily">@font/marcellus_regular</item>
        <item name="android:textStyle">bold</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="SecondFontFamily">
        <item name="fontFamily">@font/marcellus_regular</item>
    </style>

    <style name="FontFamilyHelvetica">
        <item name="fontFamily">@font/helvetica</item>
    </style>

    <style name="FontFamilyHelveticaThin">
        <item name="fontFamily">@font/helvetica_neue_thin</item>
    </style>

    <style name="SearchViewStyle" parent="Widget.AppCompat.Light.SearchView">
        <item name="android:textSize">@dimen/_12sdp</item>
        <item name="fontFamily">@font/helvetica_neue_thin</item>
        <item name="android:layout_gravity">center_vertical</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:colorPrimary">@color/black</item>
        <item name="android:textColorPrimary">@color/black</item>
        <item name="colorAccent">@color/black</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="RatingBarStyle" parent="Theme.AppCompat">
        <item name="colorControlNormal">@color/photon_gray</item>
        <item name="colorControlActivated">@color/photon_orange</item>
    </style>

    <style name="CustomDatePickerDialogTheme" parent="ThemeOverlay.MaterialComponents.MaterialCalendar">
        <item name="colorPrimary">@color/photon_orange</item>
        <item name="colorAccent">@color/photon_orange</item>
        <item name="android:textColorPrimary">@color/black</item>
        <item name="android:textColorSecondary">@color/black</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="android:textColorPrimaryInverse">@color/black</item>
        <item name="android:textColorSecondaryInverse">@color/black</item>
    </style>

    <style name="CustomPopupMenuTextStyle" parent="Widget.AppCompat.PopupMenu">
        <item name="android:textColor">@color/black</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAppearance">?android:attr/textAppearanceMedium</item>
    </style>

    <style name="FullScreenDialogStyle" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>