<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/parentFragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:visibility="gone"
    tools:context=".fragment.product.ProductDetailsFragment">

    <include
        android:id="@+id/topBar"
        layout="@layout/top_bar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/logo"
        android:layout_below="@id/topBar">


        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/white"
                android:orientation="vertical">

                <RelativeLayout
                    android:id="@+id/topLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/viewPager"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_300sdp" />

                    <RelativeLayout
                        android:id="@+id/curveLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true">

                        <ImageView
                            android:id="@+id/like"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/_12sdp"
                            android:layout_toStartOf="@id/share"
                            android:src="@drawable/wishlist" />

                        <ImageView
                            android:id="@+id/share"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_marginEnd="@dimen/_12sdp"
                            android:src="@drawable/share" />

                        <com.tbuonomo.viewpagerdotsindicator.WormDotsIndicator
                            android:id="@+id/dotsIndicator"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_8sdp"
                            app:dotsColor="@color/Deep_Saffron"
                            app:dotsCornerRadius="8dp"
                            app:dotsSize="@dimen/_8sdp"
                            app:dotsSpacing="4dp"
                            app:dotsStrokeColor="@color/white"
                            app:dotsStrokeWidth="@dimen/_1sdp" />


                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_12sdp"
                            android:scaleType="fitEnd"
                            android:src="@drawable/bottom_sheet_curve_shape" />

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerHorizontal="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/line" />

                        <TextView
                            android:id="@+id/categoryName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentBottom="true"
                            android:layout_marginStart="@dimen/_22sdp"
                            android:fontFamily="@font/marcellus"
                            android:text="Sensor Tap"
                            android:textColor="@color/Deep_Saffron"
                            android:textSize="@dimen/_12sdp"
                            android:textStyle="bold" />

                    </RelativeLayout>

                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white">

                    <TextView
                        android:id="@+id/productName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_marginStart="@dimen/_22sdp"
                        android:layout_marginEnd="@dimen/_32sdp"
                        android:layout_toStartOf="@id/countLayout"
                        android:fontFamily="@font/marcellus"
                        android:singleLine="true"
                        android:text="BP-F412 Floor Mounted\nSendor Faucet DC"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_14sdp"
                        android:textStyle="bold" />

                    <FrameLayout
                        android:id="@+id/cartLayout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_marginEnd="@dimen/_12sdp"
                        android:visibility="gone">

                        <ProgressBar
                            android:id="@+id/cartProgress"
                            android:layout_width="@dimen/_30sdp"
                            android:layout_height="@dimen/_30sdp"
                            android:layout_gravity="center"
                            android:indeterminateTint="@color/Deep_Saffron"
                            android:visibility="gone" />

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:padding="@dimen/_12sdp"
                            android:src="@drawable/cart" />
                    </FrameLayout>


                    <LinearLayout
                        android:id="@+id/countLayout"
                        android:layout_width="@dimen/_100sdp"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_marginEnd="@dimen/_5sdp"
                        android:background="@drawable/light_white_corner_round_style"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <ImageView
                            android:id="@+id/minus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="@dimen/_8sdp"
                            android:src="@drawable/minus" />

                        <FrameLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">

                            <TextView
                                android:id="@+id/itemCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:fontFamily="@font/marcellus"
                                android:padding="@dimen/_8sdp"
                                android:text="1"
                                android:textSize="@dimen/_12sdp"
                                android:textStyle="bold" />

                            <ProgressBar
                                android:id="@+id/progressBar"
                                android:layout_width="@dimen/_25sdp"
                                android:layout_height="@dimen/_25sdp"
                                android:layout_gravity="center"
                                android:indeterminateTint="@color/Deep_Saffron"
                                android:visibility="gone" />
                        </FrameLayout>


                        <ImageView
                            android:id="@+id/plus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="@dimen/_8sdp"
                            android:src="@drawable/plus" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/productName"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/productDescription"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_22sdp"
                            android:layout_marginTop="@dimen/_22sdp"
                            android:fontFamily="@font/marcellus"
                            android:text="Simple, clean, stylish design - Heavy - duty chrome..."
                            android:textSize="@dimen/_11sdp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/productDescription"
                            android:layout_marginStart="@dimen/_22sdp"
                            android:layout_marginTop="@dimen/_5sdp"
                            android:src="@drawable/shape_line" />

                        <TextView
                            android:id="@+id/price"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_22sdp"
                            android:layout_marginTop="@dimen/_12sdp"
                            android:fontFamily="@font/helvetica_neue"
                            android:text="₹ 3,499.00"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_18sdp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/discountPrice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_22sdp"
                            android:fontFamily="@font/helvetica_neue"
                            android:text="@string/strike"
                            android:textColor="#D0D0D5"
                            android:textSize="@dimen/_14sdp" />

                        <LinearLayout
                            android:id="@+id/downloadBrochureLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginStart="@dimen/_22sdp"
                            android:layout_marginTop="@dimen/_12sdp"
                            android:layout_marginEnd="@dimen/_22sdp"
                            android:background="@drawable/light_white_corner_round_style">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:drawablePadding="@dimen/_12sdp"
                                android:fontFamily="@font/marcellus"
                                android:gravity="center_vertical"
                                android:padding="@dimen/_12sdp"
                                android:text="@string/download_brochure"
                                android:textColor="@color/black"
                                android:textStyle="bold"
                                app:drawableStartCompat="@drawable/_72461_download_arrow_icon" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_8sdp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/specifications"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_weight="1"
                                android:fontFamily="@font/marcellus"
                                android:gravity="center"
                                android:padding="@dimen/_12sdp"
                                android:text="Specifications"
                                android:textColor="@color/black"
                                android:textSize="@dimen/_12sdp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/features"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_weight="1"
                                android:fontFamily="@font/marcellus"
                                android:gravity="center"
                                android:padding="@dimen/_12sdp"
                                android:text="Features"
                                android:textColor="@color/black"
                                android:textSize="@dimen/_12sdp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/youtube"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_weight="1"
                                android:fontFamily="@font/marcellus"
                                android:gravity="center"
                                android:padding="@dimen/_12sdp"
                                android:text="Youtube"
                                android:textColor="@color/black"
                                android:textSize="@dimen/_12sdp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@color/white">

                            <View
                                android:id="@+id/indicatorView2"
                                android:layout_width="match_parent"
                                android:layout_height="3dp"
                                android:background="@drawable/indicator_layout_background"
                                android:visibility="gone" />
                        </LinearLayout>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/specificationsRv"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_5sdp" />

                        <LinearLayout
                            android:id="@+id/featuresLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/featuresRv"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/_12sdp"
                                android:layout_marginTop="@dimen/_12sdp"
                                android:layout_marginEnd="@dimen/_12sdp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/reviewLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/_12sdp"
                                android:layout_marginTop="@dimen/_12sdp"
                                android:fontFamily="@font/marcellus"
                                android:text="@string/reviews"
                                android:textColor="@color/black"
                                android:textSize="@dimen/_14sdp"
                                android:textStyle="bold" />

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/_12sdp"
                                android:layout_marginEnd="@dimen/_12sdp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/marcellus"
                                    android:padding="@dimen/_8sdp"
                                    android:textColor="@color/light_white"
                                    android:textSize="@dimen/_12sdp" />

                                <TextView
                                    android:id="@+id/viewAll"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentEnd="true"
                                    android:fontFamily="@font/marcellus"
                                    android:padding="@dimen/_8sdp"
                                    android:text="view All"
                                    android:textColor="@color/Deep_Saffron"
                                    android:textSize="@dimen/_12sdp" />
                            </RelativeLayout>

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/reviewImageRv"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/_12sdp"
                                android:layout_marginEnd="@dimen/_12sdp" />

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/reviewRv"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/_12sdp"
                                android:layout_marginTop="@dimen/_12sdp"
                                android:layout_marginEnd="@dimen/_12sdp" />
                        </LinearLayout>


                        <LinearLayout
                            android:id="@+id/youtubeLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone"
                            android:padding="@dimen/_10sdp"
                            >

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/grey_background_style"
                                android:orientation="vertical"
                                android:padding="@dimen/_12sdp">

                                <TextView
                                    android:id="@+id/installationVideoLayout"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:drawablePadding="@dimen/_10sdp"
                                    android:fontFamily="@font/marcellus"
                                    android:gravity="center_vertical"
                                    android:padding="@dimen/_10sdp"
                                    android:text="Installation Video"
                                    android:textColor="@color/black"
                                    android:textStyle="bold"
                                    app:drawableEndCompat="@drawable/arrow_down"
                                    tools:ignore="HardcodedText" />

                                <androidx.cardview.widget.CardView
                                    android:id="@+id/installationVideoPlayerViewLayout"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_margin="@dimen/_10sdp"
                                    app:cardCornerRadius="@dimen/_10sdp"
                                    app:cardElevation="0dp">

                                    <com.pierfrancescosoffritti.androidyoutubeplayer.core.player.views.YouTubePlayerView
                                        android:id="@+id/installationVideoPlayerView"
                                        android:layout_width="match_parent"
                                        android:layout_height="200dp"
                                        android:visibility="visible"
                                        app:autoPlay="false"
                                        tools:ignore="TooDeepLayout" />

                                </androidx.cardview.widget.CardView>

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_12sdp"
                                android:background="@drawable/grey_background_style"
                                android:orientation="vertical"
                                android:padding="@dimen/_12sdp">

                                <TextView
                                    android:id="@+id/demoVideoLayout"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:drawablePadding="@dimen/_10sdp"
                                    android:gravity="center_vertical"
                                    android:padding="@dimen/_10sdp"
                                    android:text="Demo Video"
                                    android:textColor="@color/grey"
                                    app:cornerRadius="@dimen/_20sdp"
                                    app:drawableEndCompat="@drawable/arrow_down"
                                    tools:ignore="HardcodedText" />

                                <androidx.cardview.widget.CardView
                                    android:id="@+id/demoVideoPlayerViewLayout"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_margin="@dimen/_10sdp"
                                    app:cardCornerRadius="@dimen/_10sdp"
                                    app:cardElevation="0dp">

                                    <com.pierfrancescosoffritti.androidyoutubeplayer.core.player.views.YouTubePlayerView
                                        android:id="@+id/demoVideoPlayerView"
                                        android:layout_width="match_parent"
                                        android:layout_height="200dp"
                                        android:layout_gravity="center"
                                        tools:ignore="TooDeepLayout" />

                                </androidx.cardview.widget.CardView>

                            </LinearLayout>


                        </LinearLayout>

                    </LinearLayout>

                </RelativeLayout>

                <com.droidbond.loadingbutton.LoadingButton
                    android:id="@+id/purchaseNowBtn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_50sdp"
                    android:layout_marginStart="@dimen/_12sdp"
                    android:layout_marginTop="@dimen/_20sdp"
                    android:layout_marginEnd="@dimen/_12sdp"
                    app:background="@drawable/button_background"
                    app:boldText="true"
                    app:text="Purchase Now"
                    app:textSize="@dimen/_12sdp" />

                <com.droidbond.loadingbutton.LoadingButton
                    android:id="@+id/enquireNowBtn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_50sdp"
                    android:layout_marginStart="@dimen/_12sdp"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:layout_marginEnd="@dimen/_12sdp"
                    app:background="@drawable/button_background"
                    app:boldText="true"
                    app:text="Enquire Now"
                    app:textSize="@dimen/_12sdp" />

                <androidx.cardview.widget.CardView
                    android:id="@+id/outOfStockBtn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_50sdp"
                    android:layout_marginStart="@dimen/_12sdp"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:layout_marginEnd="@dimen/_12sdp"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/red"
                    app:cardCornerRadius="@dimen/_32sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="@font/marcellus"
                        android:text="Out of stock"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_12sdp"
                        android:textStyle="bold" />
                </androidx.cardview.widget.CardView>

                <com.droidbond.loadingbutton.LoadingButton
                    android:id="@+id/viewCart"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_50sdp"
                    android:layout_marginStart="@dimen/_12sdp"
                    android:layout_marginTop="@dimen/_20sdp"
                    android:layout_marginEnd="@dimen/_12sdp"
                    android:visibility="gone"
                    app:background="@drawable/button_background"
                    app:boldText="true"
                    app:text="View Cart"
                    app:textSize="@dimen/_12sdp" />

                <TextView
                    android:id="@+id/rent"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_50sdp"
                    android:layout_gravity="center"
                    android:layout_marginStart="@dimen/_12sdp"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:layout_marginEnd="@dimen/_12sdp"
                    android:background="@drawable/black_btn_background"
                    android:gravity="center"
                    android:text="Rent@ 199"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_12sdp" />

            </LinearLayout>
        </FrameLayout>
    </androidx.core.widget.NestedScrollView>


    <ImageView
        android:id="@+id/logo"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/_30sdp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/_12sdp"
        android:layout_marginBottom="@dimen/_12sdp"
        android:src="@drawable/logo" />

</RelativeLayout>
